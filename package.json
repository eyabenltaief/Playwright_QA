  "scripts": {
    "test": "playwright test",
    "test:edge": "playwright test --project=edge --headed tests/todo-demo.spec.ts",
    "test:ui": "playwright test --ui",
    "report:edge": "playwright test --project=edge --reporter html --headed tests/wikipedia.test.ts"
  },
